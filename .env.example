# Which source to use: jamendo | tidal | custom
# TIDAL search uses the public catalog API; playback uses a hifi-api-compatible
# endpoint that you operate and are authorized to use.
TIDAL_HIFI_API_URL=
TIDAL_HIFI_API_USER_AGENT=BitChord-TIDAL/1.0
TIDAL_PUBLIC_TOKEN=49YxDN9a2aFV6RTG
TIDAL_COUNTRY_CODE=IN
TIDAL_LOCALE=en_US
TIDAL_DEVICE_TYPE=BROWSER
PROVIDER=jamendo
JAMENDO_CLIENT_ID=

# Addon identity shown in BitChord
ADDON_ID=dev.example.bitchord-addon
ADDON_NAME=My BitChord Addon

# Addon auth (optional, see README). Needs src/bitchord-addon-auth.mjs from the BitChord docs.
BITCHORD_AUTH=0
ADDON_HOSTS=my-addon.vercel.app
